# [MAXTER CHAT STORAGE - START: VARIABLES DE ENTORNO]
# Activa o desactiva únicamente el guardado. Si falla, el bot sigue funcionando.
CHAT_STORAGE_ENABLED=true

# RECOMENDADO EN RENDER: pega aquí la Internal Database URL de PostgreSQL.
# En Render debe configurarse como variable de entorno, no dejarse en el repositorio.
DATABASE_URL=postgresql://usuario:password@host:5432/base_de_datos

# FALLBACK LOCAL: se utiliza sólo cuando DATABASE_URL no está configurada.
# En Render este archivo puede perderse al desplegar si no existe disco persistente.
CHAT_DB_PATH=backend/data/maxter_chat_history.sqlite3
# [MAXTER CHAT STORAGE - END: VARIABLES DE ENTORNO]
